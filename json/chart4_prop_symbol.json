{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Bowel Cancer Screening Participation by PHN",
    "subtitle": "2020-2021",
    "font": "Open Sans",
    "fontSize": 14,
    "fontWeight": 600,
    "subtitleFont": "Open Sans",
    "subtitleFontSize": 11,
    "subtitleColor": "#555555",
    "subtitleFontWeight": 400,
    "anchor": "middle",
    "align": "center",
    "offset": 8
  },
  "width": "container",
  "height":500,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "projection": {
  "type": "conicConformal",
  "parallels": [-18, -36],
  "rotate": [-133, 0, 0],
  "center": [0, -27],
  "scale": { "expr": "min(width * 1.5, 600)" }
},
  "layer": [
    {
      "data": {
        "url": "data/au_states.json",
        "format": {
          "type": "topojson",
          "feature": "STE_2021_AUST_GDA2020"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f1f4f6",
        "stroke": "#b8c2cc",
        "strokeWidth": 0.8
      }
    },
    {
      "data": {
        "url": "data/bowel_cancer_byPHN.csv",
        "format": {
          "type": "csv",
          "parse": {
            "Latitude": "number",
            "Longitude": "number",
            "Participation (%)": "number"
          }
        }
      },
      "transform": [
        {
          "calculate": "toNumber(replace(datum.Invited, ',', ''))",
          "as": "EligiblePopulation"
        },
        {
          "filter": "isValid(datum.EligiblePopulation) && isValid(datum.Latitude) && isValid(datum.Longitude) && isValid(datum['Participation (%)'])"
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.72,
        "stroke": "#1a252c",
        "strokeWidth": 0.6
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "EligiblePopulation",
          "type": "quantitative",
          "title": "Eligible Population",
          "scale": {
            "type": "linear",
            "domain": [10000, 400000],
            "range": [30, 450],
            "clamp": true,
            "zero": false
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "title": "Eligible Population",
            "values": [100000, 200000, 300000, 400000],
            "format": "~s",
            "symbolType": "circle",
            "symbolStrokeColor": "#1a252c",
            "symbolFillColor": "#b8a4d9",
            "titleFont": "Open Sans",
            "titleFontSize": 11,
            "titleFontWeight": 600,
            "labelFont": "Open Sans",
            "labelFontSize": 10,
            "symbolSize": 70,
            "padding": 6,
            "offset": 8
          }
        },
        "color": {
          "field": "Participation (%)",
          "type": "quantitative",
          "title": "Participation Rate (%)",
          "scale": {
            "scheme": "purples",
            "domain": [20, 50],
            "clamp": true
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "format": ".1f",
            "titleFont": "Open Sans",
            "titleFontSize": 11,
            "titleFontWeight": 600,
            "labelFont": "Open Sans",
            "labelFontSize": 10,
            "gradientLength": 140,
            "gradientThickness": 12,
            "padding": 6,
            "offset": 8
          }
        },
        "tooltip": [
          {
            "field": "PHN name",
            "type": "nominal",
            "title": "Primary Health Network"
          },
          {
            "field": "EligiblePopulation",
            "type": "quantitative",
            "title": "Eligible Population",
            "format": ",.0f"
          },
          {
            "field": "Participation (%)",
            "type": "quantitative",
            "title": "Participation Rate (%)",
            "format": ".1f"
          }
        ]
      }
    }
  ],
  "config": {
    "font": "Open Sans",
    "view": {
      "stroke": null
    },
    "legend": {
      "labelLimit": 180,
      "columnPadding": 12,
      "rowPadding": 4,
      "titleLimit": 180
    }
  }
}
