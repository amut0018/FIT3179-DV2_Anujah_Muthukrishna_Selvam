{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 380,
  "data": {
    "url": "data/Screening_Activity_Data_20230714.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Year": "number",
        "Value": "string"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.State === 'Australia' && datum.Year >= 2018 && datum.Year <= 2023 && ((datum.Program === 'Bowel' && datum.Sex === 'Persons' && datum.MeasureName === 'Number of kits returned') || (datum.Program === 'Breast' && datum.Sex === 'Females' && datum.MeasureName === 'Number of screening visits') || (datum.Program === 'Cervical' && datum.Sex === 'Females' && datum.MeasureName === 'Number of screening tests'))"
    },
    {
      "calculate": "toNumber(replace(datum.Value, /,/g, ''))",
      "as": "NumericValue"
    },
    {
      "filter": "isValid(datum.NumericValue) && isFinite(datum.NumericValue)"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "NumericValue",
          "as": "AnnualValue"
        }
      ],
      "groupby": [
        "Year",
        "Program",
        "MeasureName"
      ]
    }
  ],
  "mark": {
    "type": "area",
    "interpolate": "monotone"
  },
  "encoding": {
    "x": {
      "field": "Year",
      "type": "ordinal",
      "title": "Year",
      "scale": {
        "domain": [
          2018,
          2019,
          2020,
          2021,
          2022,
          2023
        ],
        "padding": 0
      },
      "axis": {
        "labelAngle": 0,
        "labelOverlap": false,
        "labelFontSize": 12,
        "grid": false
      }
    },
    "y": {
      "field": "AnnualValue",
      "type": "quantitative",
      "stack": "center",
      "title": "Total screenings per year",
      "scale": {
        "zero": false,
        "nice": false,
        "padding": 70
      },
      "axis": null
    },
    "color": {
      "field": "Program",
      "type": "nominal",
      "scale": {
        "domain": [
          "Bowel",
          "Breast",
          "Cervical"
        ],
        "range": [
          "#1b9e77",
          "#d95f02",
          "#7570b3"
        ]
      },
      "legend": {
        "orient": "top",
        "title": "Program",
        "labelFont": "sans-serif",
        "symbolType": "circle"
      }
    },
    "tooltip": [
      {
        "field": "Year",
        "type": "ordinal",
        "title": "Year"
      },
      {
        "field": "Program",
        "type": "nominal",
        "title": "Program"
      },
      {
        "field": "MeasureName",
        "type": "nominal",
        "title": "Measure"
      },
      {
        "field": "AnnualValue",
        "type": "quantitative",
        "title": "Annual total",
        "format": ","
      }
    ]
  }
}