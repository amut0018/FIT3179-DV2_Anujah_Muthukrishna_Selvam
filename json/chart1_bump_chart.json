{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Annual Bowel, Breast and Cervical Cancer Screening Participation Rates",
    "subtitle": "2018-2023",
    "fontSize": 14,
    "subtitleFontSize": 11,
    "anchor": "start"
  },
  "width": "container",
  "height": 280,
  "data": {
    "url": "data/participation_rates_over_time.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Year": "number",
        "Value": "number"
      }
    }
  },
  "mark": {
    "type": "line",
    "strokeWidth": 3,
    "point": {
      "filled": true,
      "size": 90
    }
  },
  "encoding": {
    "x": {
      "field": "Year",
      "type": "ordinal",
      "title": "Year",
      "sort": "ascending",
      "axis": {
        "labelAngle": 0,
        "labelFontSize": 12,
        "grid": false
      }
    },
    "y": {
      "field": "Value",
      "type": "quantitative",
      "title": "Participation Rate (%)",
      "scale": {
        "domain": [0, 75]
      },
      "axis": {
        "grid": true,
        "labelExpr": "datum.value + '%'"
      }
    },
    "color": {
      "field": "Program",
      "type": "nominal",
      "scale": {
        "domain": ["Bowel", "Breast", "Cervical"],
        "range": ["#1b9e77", "#d95f02", "#7570b3"]
      },
      "legend": {
        "orient": "top",
        "title": "Screening Program",
        "labelFont": "sans-serif",
        "symbolType": "circle"
      }
    },
    "tooltip": [
      {
        "field": "Year",
        "type": "ordinal",
        "title": "Year"
      },
      {
        "field": "Program",
        "type": "nominal",
        "title": "Screening Program"
      },
      {
        "field": "Value",
        "type": "quantitative",
        "title": "Participation Rate (%)",
        "format": ".1f"
      }
    ]
  }
}
