
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": [
      "Annual Bowel, Breast and",
      "Cervical Cancer Screening Activity"
    ],
    "subtitle": "2018-2023",
    "font": "Open Sans",
    "fontSize": 14,
    "fontWeight": 600,
    "subtitleFont": "Open Sans",
    "subtitleFontSize": 11,
    "subtitleColor": "#555555",
    "subtitleFontWeight": 400,
    "anchor": "middle",
    "align": "center",
    "subtitlePadding": 4,
    "lineHeight": 17,
    "offset": 8
  },
  "width": "container",
  "height": 300,
  "data": {
    "url": "data/Screening_Activity_Data_20230714.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Year": "number",
        "Value": "string"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.State === 'Australia' && datum.Year >= 2018 && datum.Year <= 2023 && ((datum.Program === 'Bowel' && datum.Sex === 'Persons' && datum.MeasureName === 'Number of kits returned') || (datum.Program === 'Breast' && datum.Sex === 'Females' && datum.MeasureName === 'Number of screening visits') || (datum.Program === 'Cervical' && datum.Sex === 'Females' && datum.MeasureName === 'Number of screening tests'))"
    },
    {
      "calculate": "toNumber(replace(datum.Value, /,/g, ''))",
      "as": "NumericValue"
    },
    {
      "filter": "isValid(datum.NumericValue) && isFinite(datum.NumericValue)"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "NumericValue",
          "as": "AnnualValue"
        }
      ],
      "groupby": [
        "Year",
        "Program"
      ]
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal",
          "title": "Year",
          "scale": {
            "domain": [2018, 2019, 2020, 2021, 2022, 2023]
          },
          "axis": {
            "labelAngle": 0,
            "labelOverlap": false,
            "labelFont": "Open Sans",
            "labelFontSize": 10,
            "titleFont": "Open Sans",
            "titleFontSize": 11,
            "titleFontWeight": 600,
            "grid": false
          }
        },
        "y": {
          "field": "AnnualValue",
          "type": "quantitative",
          "title": "Number of Participants",
          "scale": {
            "zero": true,
            "nice": true
          },
          "axis": {
            "grid": true,
            "format": "~s",
            "labelFont": "Open Sans",
            "labelFontSize": 10,
            "titleFont": "Open Sans",
            "titleFontSize": 11,
            "titleFontWeight": 600
          }
        },
        "color": {
          "field": "Program",
          "type": "nominal",
          "scale": {
            "domain": ["Bowel", "Breast", "Cervical"],
            "range": ["#1b9e77", "#d95f02", "#7570b3"]
          },
          "legend": {
            "orient": "top",
            "title": "Screening Program",
            "titleFont": "Open Sans",
            "titleFontSize": 11,
            "titleFontWeight": 600,
            "labelFont": "Open Sans",
            "labelFontSize": 10,
            "labelFontWeight": 400,
            "symbolType": "circle"
          }
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 110
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal"
        },
        "y": {
          "field": "AnnualValue",
          "type": "quantitative"
        },
        "color": {
          "field": "Program",
          "type": "nominal"
        },
        "tooltip": [
          {
            "field": "Year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "Program",
            "type": "nominal",
            "title": "Screening Program"
          },
          {
            "field": "AnnualValue",
            "type": "quantitative",
            "title": "Number of Participants",
            "format": ","
          }
        ]
      }
    }
  ],
  "config": {
    "font": "Open Sans",
    "title": {
      "font": "Open Sans",
      "fontSize": 14,
      "fontWeight": 600,
      "subtitleFont": "Open Sans",
      "subtitleFontSize": 11,
      "subtitleColor": "#555555",
      "subtitleFontWeight": 400
    },
    "axis": {
      "labelFont": "Open Sans",
      "labelFontSize": 10,
      "titleFont": "Open Sans",
      "titleFontSize": 11,
      "titleFontWeight": 600
    },
    "legend": {
      "labelFont": "Open Sans",
      "labelFontSize": 10,
      "titleFont": "Open Sans",
      "titleFontSize": 11,
      "titleFontWeight": 600
    },
    "view": {
      "stroke": null
    }
  }
}
