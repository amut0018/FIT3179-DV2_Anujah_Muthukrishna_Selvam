
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": ["Breast Screening Population by State and Access"],
    "subtitle": "2021-2022",
    "anchor": "center",
    "align": "center",
    "subtitleAlign": "center",
    "fontSize": 14,
    "subtitleFontSize": 11,
    "subtitlePadding": 4
  },
  "width": "container",
  "height": 450,
  "padding": {
    "bottom": 25
  },
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "data": {
    "url": "data/sa3_drivetime_screeningbreastcancer.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "filter": "datum['Service frequency'] === 'Open permanently' && datum['Indigenous status'] === 'All women aged 50–74'"
    },
    {
      "calculate": "toNumber(replace(datum['Women (total)'], ',', ''))",
      "as": "TotalWomen"
    },
    {
      "filter": "isValid(datum.TotalWomen) && datum.TotalWomen > 0"
    },
    {
      "calculate": "toNumber(replace(replace(replace(replace(datum['Proportion (0–20 mins)'], '%', ''), '–', '0'), '<0.1', '0'), '>99.9', '100')) * datum.TotalWomen",
      "as": "Within20"
    },
    {
      "calculate": "toNumber(replace(replace(replace(replace(datum['Proportion (>20–60 mins)'], '%', ''), '–', '0'), '<0.1', '0'), '>99.9', '100')) * datum.TotalWomen",
      "as": "Within20To60"
    },
    {
      "calculate": "toNumber(replace(replace(replace(replace(datum['Proportion (>60–120 mins)'], '%', ''), '–', '0'), '<0.1', '0'), '>99.9', '100')) * datum.TotalWomen",
      "as": "Within60To120"
    },
    {
      "calculate": "toNumber(replace(replace(replace(replace(datum['Proportion (>120 mins)'], '%', ''), '–', '0'), '<0.1', '0'), '>99.9', '100')) * datum.TotalWomen",
      "as": "Over120"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "Within20",
          "as": "Within20"
        },
        {
          "op": "sum",
          "field": "Within20To60",
          "as": "Within20To60"
        },
        {
          "op": "sum",
          "field": "Within60To120",
          "as": "Within60To120"
        },
        {
          "op": "sum",
          "field": "Over120",
          "as": "Over120"
        },
        {
          "op": "sum",
          "field": "TotalWomen",
          "as": "TotalWomen"
        }
      ],
      "groupby": ["Jurisdiction"]
    },
    {
      "fold": [
        "Within20",
        "Within20To60",
        "Within60To120",
        "Over120"
      ],
      "as": ["Band", "Weighted"]
    },
    {
      "calculate": "datum.Weighted / datum.TotalWomen",
      "as": "Proportion"
    },
    {
      "calculate": "format(datum.Proportion, '.1f') + '%'",
      "as": "ProportionLabel"
    },
    {
      "calculate": "datum.Band === 'Within20' ? '0–20' : datum.Band === 'Within20To60' ? '>20–60' : datum.Band === 'Within60To120' ? '>60–120' : '>120'",
      "as": "DriveTime"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "DriveTime",
          "type": "ordinal",
          "title": "Drive Time to Screening Service (minutes)",
          "sort": [
            "0–20",
            ">20–60",
            ">60–120",
            ">120"
          ],
          "axis": {
            "labelAngle": 0,
            "labelFontSize": 10,
            "titleFontSize": 11,
            "titlePadding": 10
          }
        },
        "y": {
          "field": "Jurisdiction",
          "type": "ordinal",
          "title": "State",
          "sort": [
            "New South Wales",
            "Victoria",
            "Queensland",
            "South Australia",
            "Western Australia",
            "Tasmania",
            "Northern Territory",
            "Australian Capital Territory"
          ],
          "axis": {
            "labelFontSize": 10,
            "titleFontSize": 11
          }
        },
        "color": {
          "field": "Proportion",
          "type": "quantitative",
          "scale": {
            "type": "sqrt",
            "domain": [0, 5, 20, 50, 100],
            "range": [
              "#f7fbff",
              "#c6dbef",
              "#6baed6",
              "#2171b5",
              "#08306b"
            ],
            "clamp": true
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "titleAnchor": "start",
            "titleAlign": "left",
            "gradientLength": 200,
            "gradientThickness": 14,
            "titleFontSize": 11,
            "labelFontSize": 10,
            "titlePadding": 6,
            "format": ".0f",
            "labelExpr": "datum.label + '%'",
            "title": "Proportion of Eligible Women (%)",
            "offset": 20,
            "values": [0, 5, 20, 50, 100],
            "orient": "bottom"
          }
        },
        "tooltip": [
          {
            "field": "Jurisdiction",
            "type": "nominal",
            "title": "State / Territory"
          },
          {
            "field": "DriveTime",
            "type": "nominal",
            "title": "Drive Time (minutes)"
          },
          {
            "field": "ProportionLabel",
            "type": "nominal",
            "title": "Proportion of Eligible Women"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 10,
        "fontWeight": 400
      },
      "encoding": {
        "x": {
          "field": "DriveTime",
          "type": "ordinal",
          "sort": [
            "0–20",
            ">20–60",
            ">60–120",
            ">120"
          ]
        },
        "y": {
          "field": "Jurisdiction",
          "type": "ordinal",
          "sort": [
            "New South Wales",
            "Victoria",
            "Queensland",
            "South Australia",
            "Western Australia",
            "Tasmania",
            "Northern Territory",
            "Australian Capital Territory"
          ]
        },
        "text": {
          "field": "ProportionLabel",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "datum.Proportion > 35",
            "value": "white"
          },
          "value": "#1a2a3a"
        }
      }
    }
  ],
  "resolve": {
    "scale": {
      "color": "shared"
    }
  }
}
