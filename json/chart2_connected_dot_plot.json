
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": [
      "Bowel Cancer Screening Participation",
      "Rates by Age & Sex"
    ],
    "subtitle": "2020-2021",
    "font": "Open Sans",
    "fontSize": 14,
    "fontWeight": 600,
    "subtitleFont": "Open Sans",
    "subtitleFontSize": 11,
    "subtitleColor": "#555555",
    "subtitleFontWeight": 400,
    "anchor": "middle",
    "align": "center",
    "subtitlePadding": 4,
    "lineHeight": 17,
    "offset": 8
  },
  "width": "container",
  "height": 300,
  "data": {
    "url": "data/chart2_bowelcancer_2020-2021.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Value": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.Program == 'Bowel'"
    },
    {
      "filter": "datum.MeasureName == 'Participation rate (%)'"
    },
    {
      "filter": "datum.State == 'Australia' || datum.State == 'Aust' || datum.State == 'National' || datum.GeographicAreaName == 'Australia'"
    },
    {
      "filter": "test(/2020/i, datum.Period)"
    },
    {
      "filter": "datum.Sex == 'Females' || datum.Sex == 'Males'"
    },
    {
      "filter": "test(/^50[–-]54|^55[–-]59|^60[–-]64|^65[–-]69|^70[–-]74/, datum.AgeGroup)"
    },
    {
      "filter": "isValid(datum.Value) && datum.Value > 0"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "color": "#b0bec5",
        "strokeWidth": 3
      },
      "encoding": {
        "y": {
          "field": "AgeGroup",
          "type": "nominal",
          "title": "Age Group",
          "sort": "ascending",
          "axis": {
            "labelAngle": 0,
            "labelFont": "Open Sans",
            "labelFontSize": 10,
            "labelPadding": 8,
            "titleFont": "Open Sans",
            "titleFontSize": 11,
            "titleFontWeight": 600
          }
        },
        "x": {
          "field": "Value",
          "type": "quantitative",
          "title": "Participation Rate (%)",
          "scale": {
            "domain": [0, 80]
          },
          "axis": {
            "grid": true,
            "tickCount": 6,
            "labelFont": "Open Sans",
            "labelFontSize": 10,
            "titleFont": "Open Sans",
            "titleFontSize": 11,
            "titleFontWeight": 600
          }
        },
        "detail": {
          "field": "AgeGroup"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 70,
        "opacity": 1
      },
      "encoding": {
        "y": {
          "field": "AgeGroup",
          "type": "nominal",
          "sort": "ascending"
        },
        "x": {
          "field": "Value",
          "type": "quantitative"
        },
        "color": {
          "field": "Sex",
          "type": "nominal",
          "scale": {
            "domain": ["Females", "Males"],
            "range": ["#e7298a", "#1f78b4"]
          },
          "legend": {
            "orient": "top",
            "title": null,
            "labelFont": "Open Sans",
            "labelFontSize": 10,
            "labelFontWeight": 400,
            "symbolSize": 80
          }
        },
        "tooltip": [
          {
            "field": "AgeGroup",
            "type": "nominal",
            "title": "Age Group"
          },
          {
            "field": "Sex",
            "type": "nominal",
            "title": "Sex"
          },
          {
            "field": "Value",
            "type": "quantitative",
            "title": "Participation Rate (%)",
            "format": ".1f"
          }
        ]
      }
    }
  ],
  "config": {
    "font": "Open Sans",
    "title": {
      "font": "Open Sans",
      "fontSize": 14,
      "fontWeight": 600,
      "subtitleFont": "Open Sans",
      "subtitleFontSize": 11,
      "subtitleColor": "#555555",
      "subtitleFontWeight": 400,
      "anchor": "middle",
      "align": "center"
    },
    "axis": {
      "labelFont": "Open Sans",
      "labelFontSize": 10,
      "titleFont": "Open Sans",
      "titleFontSize": 11,
      "titleFontWeight": 600
    },
    "legend": {
      "labelFont": "Open Sans",
      "labelFontSize": 10,
      "titleFont": "Open Sans",
      "titleFontSize": 11,
      "titleFontWeight": 600
    },
    "view": {
      "stroke": null
    }
  }
}
