{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 280,
  "data": {
    "url": "data/chart2_bowelcancer_2020-2021.csv",
    "format": {
      "type": "csv",
      "parse": {"Value": "number"}
    }
  },
  "transform": [
    {
      "filter": "datum.Program == 'Bowel'"
    },
    {
      "filter": "test(/rate/i, datum.MeasureName)"
    },
    {
      "filter": "datum.State == 'Australia' || datum.State == 'Aust' || datum.State == 'National' || datum.GeographicAreaName == 'Australia'"
    },
    {
      "filter": "test(/2020/i, datum.Period)"
    },
    {
      "filter": "datum.Sex == 'Females' || datum.Sex == 'Males'"
    },
    {
      "filter": "test(/^50[–-]54|^55[–-]59|^60[–-]64|^65[–-]69|^70[–-]74/, datum.AgeGroup)"
    },
    {
      "filter": "isValid(datum.Value) && datum.Value > 0"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "color": "#b0bec5",
        "size": 3
      },
      "encoding": {
        "y": {
          "field": "AgeGroup",
          "type": "nominal",
          "title": "Age Cohort",
          "sort": "ascending",
          "axis": {
            "labelAngle": 0,
            "labelFontSize": 11,
            "labelPadding": 8
          }
        },
        "x": {
          "field": "Value",
          "type": "quantitative",
          "title": "Participation Rate (%)",
          "scale": {"domain": [0, 80]},
          "axis": {
            "grid": true,
            "tickCount": 6
          }
        },
        "detail": {
          "field": "AgeGroup"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 70,
        "opacity": 1
      },
      "encoding": {
        "y": {
          "field": "AgeGroup",
          "type": "nominal",
          "sort": "ascending"
        },
        "x": {
          "field": "Value",
          "type": "quantitative"
        },
        "color": {
          "field": "Sex",
          "type": "nominal",
          "scale": {
            "domain": ["Females", "Males"],
            "range": ["#e7298a", "#1f78b4"]
          },
          "legend": {
            "orient": "top",
            "title": null,
            "labelFontSize": 11,
            "symbolSize": 80
          }
        },
        "tooltip": [
          {"field": "AgeGroup", "type": "nominal", "title": "Age Group"},
          {"field": "Sex", "type": "nominal", "title": "Sex"},
          {"field": "Value", "type": "quantitative", "title": "Participation Rate (%)", "format": ".1f"},
          {"field": "Period", "type": "nominal", "title": "Period"},
          {"field": "State", "type": "nominal", "title": "State"}
        ]
      }
    }
  ]
}